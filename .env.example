# Copy this file to .env before running Docker Compose. Values must be set:
# Compose intentionally refuses to start with a missing or empty credential.
# Use independent URL-safe secrets, for example: openssl rand -hex 32

MONGO_ROOT_USER=textbee_admin
MONGO_ROOT_PASS=
MONGO_APP_USER=textbee_app
MONGO_APP_PASS=
REDIS_PASSWORD=
JWT_SECRET=

# Optional loopback listener overrides for a host reverse proxy.
API_BIND_PORT=3001
WEB_BIND_PORT=3000
